# Copy to poc/.env and fill in what you use. Real environment variables win over this file.

# ── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml (docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stackforge

# ── LLM provider: groq | gemini | openrouter | ollama ────────────────────────
LLM_PROVIDER=groq

# groq: free key at https://console.groq.com (models fixed in config.py)
GROQ_API_KEY=

# gemini: free key at https://aistudio.google.com/apikey
# Partial: summarisation works, extraction returns markdown instead of JSON (Nov 2026).
GEMINI_API_KEY=
# GEMINI_MODEL_CHEAP=gemini-flash-lite-latest
# GEMINI_MODEL_CAPABLE=gemini-3.5-flash

# openrouter: key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL_CHEAP=nvidia/nemotron-nano-9b-v2:free
# OPENROUTER_MODEL_CAPABLE=nvidia/nemotron-3-super-120b-a12b:free

# ollama: local, no key (ollama pull qwen2.5-coder:3b). Excluded from cost reports.
# OLLAMA_MODEL_CHEAP=qwen2.5-coder:3b
# OLLAMA_MODEL_CAPABLE=qwen2.5-coder:3b
# OLLAMA_NUM_CTX=8192

# ── Optional: Pinecone semantic search (blank = BM25 keyword search only) ─────
PINECONE_API_KEY=
# PINECONE_INDEX_NAME=stackforge-poc
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# ── Optional: Azure DevOps push (Stages 2-3) ─────────────────────────────────
ADO_ORG=
ADO_PROJECT=
ADO_PAT=

# ── Optional: Google Stitch UI design generation ─────────────────────────────
STITCH_API_KEY=

# ── Stage 4 code generation throttling ───────────────────────────────────────
# Groq free tier is ~8K tokens/min, hence 1 task at a time with a 30s hold.
# For ollama set STAGE4_THROTTLE_DELAY_S=0.
# STAGE4_MAX_PARALLEL=1
# STAGE4_THROTTLE_DELAY_S=30.0

# ── UI ───────────────────────────────────────────────────────────────────────
# STACKFORGE_API_URL=http://127.0.0.1:8000
