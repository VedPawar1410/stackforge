    {
      "id": "rulesTitle",
      "type": "text",
      "x": 40,
      "y": 990,
      "width": 900,
      "height": 28,
      "strokeColor": "#1e1e1e",
      "text": "The 4 Golden Rules — applied at every stage",
      "fontSize": 20,
      "fontFamily": 2,
      "createdAt": "2026-08-05T07:19:33.425Z",
      "updatedAt": "2026-08-05T07:19:33.425Z",
      "version": 1
    },
    {
      "id": "r1",
      "type": "rectangle",
      "x": 40,
      "y": 1030,
      "width": 330,
      "height": 100,
      "backgroundColor": "#ffffff",
      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "1. Model Routing\ncheap → mid → premium\nrouter itself runs on cheap model"
      },
      "fontSize": 15,
      "fontFamily": 2,
      "createdAt": "2026-08-05T07:19:33.425Z",
      "updatedAt": "2026-08-05T07:19:33.425Z",
      "version": 1
    },
    {
      "id": "r2",
      "type": "rectangle",
      "x": 400,
      "y": 1030,
      "width": 330,
      "height": 100,
      "backgroundColor": "#ffffff",
      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "2. Prompt Caching\nstatic context cached\n90% cost cut on cache hits"
      },
      "fontSize": 15,
      "fontFamily": 2,
      "createdAt": "2026-08-05T07:19:33.425Z",
      "updatedAt": "2026-08-05T07:19:33.425Z",
      "version": 1
    },
    {
      "id": "r3",
      "type": "rectangle",
      "x": 760,
      "y": 1030,
      "width": 330,
      "height": 100,
      "backgroundColor": "#ffffff",
      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "3. Batch API\nall non-real-time generation\n50% cheaper than sync"
      },
      "fontSize": 15,
      "fontFamily": 2,
      "createdAt": "2026-08-05T07:19:33.425Z",
      "updatedAt": "2026-08-05T07:19:33.425Z",
      "version": 1
    },
    {
      "id": "r4",
      "type": "rectangle",
      "x": 1120,
      "y": 1030,
      "width": 330,
      "height": 100,
      "backgroundColor": "#ffffff",
      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "4. Structured Outputs\nstrict JSON + max_tokens cap\nno free-form prose"
      },
      "fontSize": 15,
      "fontFamily": 2,
      "createdAt": "2026-08-05T07:19:33.425Z",
      "updatedAt": "2026-08-05T07:19:33.425Z",
      "version": 1
    },
    {
      "id": "combo",
      "type": "text",
      "x": 40,
      "y": 1145,
      "width": 1410,
      "height": 30,
      "strokeColor": "#2f9e44",
      "text": "Combined effect: a call applying all 4 costs ~3-5% of a naive unoptimised equivalent call",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-08-05T07:19:33.425Z",
      "updatedAt": "2026-08-05T07:19:33.425Z",
      "version": 1
    }
  ],
