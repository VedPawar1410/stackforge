      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "Session File Cache + Compression\nfetched file never re-fetched · after 8-10 turns\nolder turns → 2-3 sentence memory block"
      },
      "fontSize": 15,
      "fontFamily": 2,
      "createdAt": "2026-08-05T07:20:56.144Z",
