    {
      "id": "RAGbox",
      "type": "rectangle",
      "x": 700,
      "y": 120,
      "width": 520,
      "height": 130,
      "backgroundColor": "#99e9f2",
      "strokeColor": "#0c8599",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "RAG-on-Codebase\nembed task → top 5-10 files (semantic)\n+ top 3 skills → write ONLY those to disk\nNever load all skills for every task"
      },
      "fontSize": 15,
      "fontFamily": 2,
      "createdAt": "2026-08-05T07:20:56.144Z",
      "updatedAt": "2026-08-05T07:20:56.144Z",
      "version": 1
    },
    {
      "id": "Subbox",
      "type": "rectangle",
      "x": 700,
      "y": 270,
      "width": 520,
      "height": 130,
      "backgroundColor": "#eebefa",
      "strokeColor": "#9c36b5",
      "strokeWidth": 2,
      "roughness": 0,
      "label": {
        "text": "Hierarchical Sub-Agents\ncheap orchestrator decomposes → 3-5 sub-tasks (~1K tok)\neach sub-agent scoped to ~4-6K tok\nnaive monolithic ≈ 15K tok/turn"
      },
      "fontSize": 15,
      "fontFamily": 2,
      "createdAt": "2026-08-05T07:20:56.144Z",
      "updatedAt": "2026-08-05T07:20:56.144Z",
      "version": 1
    },
